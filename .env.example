# SMTP for the "Send brief" form (WebSupport mailbox). Check host/port in the
# WebSupport admin for the mailbox before going live.
SMTP_HOST=smtp.m1.websupport.sk
SMTP_PORT=465
# true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USER=office@ergodic.sk
SMTP_PASSWORD=

# Where briefs are delivered, and the From address (must be allowed for SMTP_USER)
CONTACT_TO=office@ergodic.sk
CONTACT_FROM="Ergodic web <office@ergodic.sk>"

# Absolute site URL, used for metadata, sitemap and hreflang
NEXT_PUBLIC_SITE_URL=https://ergodic.sk
